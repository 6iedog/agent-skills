{
  "_meta": {
    "note": "设计令牌骨架。生成后请按项目实际设计体系替换取值。",
    "rules": [
      "组件只允许消费 semantic 层与 component 层，不允许直接引用 primitive 层",
      "space.base 是间距基数，所有间距必须是它的整数倍",
      "z-index 必须用令牌，禁止出现 9999 这类魔法值",
      "令牌值一旦确定不得在组件内局部覆盖"
    ],
    "primitive": "调色板/字号刻度/间距刻度，供 semantic 层引用",
    "semantic": "组件实际消费层",
    "component": "单组件特殊值，慎用，需说明理由"
  },
  "platform": {
    "target": ["web"],
    "note": "移动端需另加：触控热区 44px、安全区 safe-area、拇指可达区"
  },

  "primitive": {
    "palette": {
      "blue": { "1": "#e6f4ff", "2": "#bae0ff", "3": "#40a9ff", "5": "#1677ff", "6": "#0958d9", "7": "#003eb3" },
      "red":   { "1": "#fff1f0", "3": "#ff7875", "5": "#f5222d", "6": "#cf1322", "7": "#a8071a" },
      "green": { "1": "#f6ffed", "3": "#73d13d", "5": "#52c41a", "6": "#389e0d", "7": "#237804" },
      "gray":  { "1": "#fafafa", "2": "#f5f5f5", "3": "#f0f0f0", "4": "#d9d9d9", "5": "#bfbfbf", "6": "#8c8c8c", "7": "#595959", "8": "#262626", "9": "#141414" }
    },
    "scale": {
      "space_base": "4px",
      "radius_scale": ["4px", "6px", "8px", "9999px"],
      "font_scale": ["12px", "14px", "16px", "20px", "24px"],
      "control_height": { "sm": "24px", "md": "32px", "lg": "40px" }
    }
  },

  "color": {
    "primary": "#1677ff",
    "primary-hover": "#4096ff",
    "primary-active": "#0958d9",
    "success": "#52c41a",
    "warning": "#faad14",
    "danger": "#f5222d",
    "danger-hover": "#ff4d4f",

    "text": "#262626",
    "text-secondary": "#595959",
    "text-tertiary": "#8c8c8c",
    "text-inverse": "#ffffff",

    "bg": "#f5f5f5",
    "bg-container": "#ffffff",
    "bg-hover": "#f5f5f5",
    "bg-active": "#e6f4ff",
    "bg-mask": "rgba(0, 0, 0, 0.45)",

    "border": "#d9d9d9",
    "border-strong": "#8c8c8c",
    "border-focus": "#1677ff"
  },

  "size": {
    "control-height": { "sm": "24px", "md": "32px", "lg": "40px" },
    "space": {
      "base": "4px", "xs": "8px", "sm": "12px", "md": "16px",
      "lg": "24px", "xl": "32px", "xxl": "48px"
    },
    "radius": { "sm": "4px", "md": "6px", "lg": "8px", "full": "9999px" },
    "font-size": { "xs": "12px", "sm": "14px", "md": "16px", "lg": "20px", "xl": "24px" }
  },

  "z-index": {
    "dropdown": 1050,
    "sticky": 1020,
    "modal": 1000,
    "tooltip": 1080,
    "toast": 1100
  },

  "motion": {
    "duration": { "fast": "0.1s", "normal": "0.2s", "slow": "0.3s" },
    "easing": { "standard": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "reduced_motion": "@media (prefers-reduced-motion: reduce) { transition: none !important; animation: none !important; }"
  },

  "click-target": { "min": "24px" },

  "_todo": [
    "替换为项目实际色值（若项目已有设计系统，优先沿用其取值）",
    "若项目用 CSS 变量方案，在此列出变量名映射，便于 check_tokens.py 识别",
    "若项目用 Tailwind/styled-components，注明类名或函数名以便校验识别"
  ]
}
